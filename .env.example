# ---------------------------------------------------------------------------
# VIH VoiceRAG configuration. Copy to .env. Never commit .env.
# All secrets are server-side only: nothing here is ever sent to the browser.
# ---------------------------------------------------------------------------

DATABASE_URL="postgresql://USER@localhost:5432/vih_voicerag?schema=public"
# Disposable database for the integration suite (tables are truncated).
DATABASE_URL_TEST="postgresql://USER@localhost:5432/vih_voicerag_test?schema=public"

PORT=3100
# Set to true ONLY when a reverse proxy in front of the app sets X-Forwarded-For. The right-most
# entry is then used as the client IP for login rate limiting; otherwise the socket address is.
TRUST_PROXY=false
# Private document storage (never served statically).
VOICERAG_STORAGE_DIR="./storage"
VOICERAG_MAX_UPLOAD_MB=20
# Days to keep conversations/messages/turn metrics (npm run retention:purge).
VOICERAG_RETENTION_DAYS=30
# Run the ingestion worker inside the web process (simple single-node deployment).
# Set to false and run `npm run worker` separately to scale ingestion independently.
VOICERAG_INPROCESS_WORKER=true
# Passwords for the seeded synthetic users (development only).
VOICERAG_SEED_PASSWORD="change-me-dev-only"

# --- Providers --------------------------------------------------------------
# Each stage is selected independently. "mock" providers are deterministic and for tests only;
# the server refuses to start with mock providers when NODE_ENV=production.

# Speech-to-text: whispercpp (local whisper.cpp server, audio never leaves the host)
#               | openai (any OpenAI-compatible /audio/transcriptions endpoint) | mock
STT_PROVIDER=whispercpp
WHISPERCPP_URL="http://127.0.0.1:8178"
WHISPERCPP_MODEL_PATH="~/.cache/whisper/ggml-base.en.bin"
# Re-transcribe the in-progress utterance this often for live partial transcripts (0 disables).
# Off by default on a single shared GPU: partials compete with the speculative pipeline.
STT_PARTIAL_INTERVAL_MS=0
# Domain vocabulary passed to the STT model as a decoding prompt (improves names and jargon).
STT_VOCABULARY="VIH Metaverse, Spaces, PeopleHub, Flagship, parental leave, per diem, pull request, SEV1, SEV2, on-call, postmortem, OpenXR, Quest 3, Vision Pro, cafeteria."
# Pre-render the whole turn (retrieval, LLM, TTS) during the end-of-speech silence window on the
# speculative transcript. Output is held server-side and released only if the end of turn confirms
# the same transcript, permission scope and history; otherwise it is aborted (false to disable).
SPECULATIVE_PRERENDER=true

# LLM: ollama (local) | anthropic | gemini | openai (any OpenAI-compatible chat endpoint) | mock
LLM_PROVIDER=ollama
LLM_MODEL="llama3.2:1b"
# Local Ollama model used automatically when a cloud LLM is selected but its key is empty
# (development only: in production a missing key stops the server unless LLM_ALLOW_LOCAL_FALLBACK=true).
LLM_FALLBACK_MODEL="llama3.2:1b"
LLM_MAX_TOKENS=160
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_MS=15000
# Ollama context window (tokens).
LLM_NUM_CTX=2048
OLLAMA_URL="http://127.0.0.1:11434"
ANTHROPIC_API_KEY=""
# Gemini (Google AI Studio key from https://aistudio.google.com/apikey), via its OpenAI-compatible API.
GEMINI_API_KEY=""
# "none" disables Gemini Flash "thinking" for faster first tokens (leave empty for other providers).
LLM_REASONING_EFFORT=""
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_STT_MODEL="gpt-4o-mini-transcribe"
# Optional USD per million tokens, for cost-per-turn estimates (leave empty if unknown).
LLM_PRICE_INPUT_PER_MTOK=""
LLM_PRICE_OUTPUT_PER_MTOK=""

# Embeddings: ollama | openai | mock. Dimension must match the vector column (768).
EMBED_PROVIDER=ollama
EMBED_MODEL="nomic-embed-text"
EMBED_DIM=768

# Text-to-speech: piper (local Piper sidecar, `npm run tts:server`; text never leaves the host)
#               | openai (OpenAI-compatible /audio/speech, PCM streaming) | browser | mock
# "browser" synthesises on the client with the Web Speech API (no server audio).
TTS_PROVIDER=piper
PIPER_URL="http://127.0.0.1:8179"
PIPER_MODEL_PATH="~/.cache/piper/en_US-lessac-medium.onnx"
TTS_VOICE="alloy"
TTS_RATE_WPM=180
OPENAI_TTS_MODEL="gpt-4o-mini-tts"

# --- Retrieval ----------------------------------------------------------------
RAG_TOP_K=3
RAG_CANDIDATES=12
CHUNK_TARGET_WORDS=100
CHUNK_OVERLAP_WORDS=20
# Abstention thresholds on the fused evidence score. Tuned by `npm run eval:rag`; they are
# NOT probabilities. See docs/ARCHITECTURE.md#confidence-and-abstention.
RAG_MIN_VECTOR_SIM=0.73
RAG_MIN_VECTOR_SIM_WITH_KEYWORD=0.66
# Borderline zone: below the thresholds above but at/above this, the best passages still go to the
# LLM and the answer is verified against them before it is spoken (0 = always abstain instead).
RAG_MIN_VECTOR_SIM_BORDERLINE=0.60
# Company-specific shorthand to expand in queries, "term=expansion; term=expansion"
# (generic workplace abbreviations such as PR, prod and WFH are built in).
RAG_QUERY_GLOSSARY="peoplehub=HR portal leave requests; flagship=feature flags"
# Corpus-wide words ignored by the keyword-coverage signal.
RAG_DOMAIN_STOPWORDS="vih metaverse company employee employees staff policy"
# Non-VIH questions with no matching documents get general guidance, clearly labelled as not from
# VIH documents. VIH-internal questions are never answered from model memory (false = always abstain).
GENERAL_ANSWERS=true
RAG_CACHE_TTL_SECONDS=300
RAG_CACHE_MAX_ENTRIES=500

# --- Limits ---------------------------------------------------------------------
VOICE_MAX_UTTERANCE_SECONDS=30
VOICE_TURNS_PER_MINUTE=20
VOICE_MAX_SESSIONS_PER_USER=3

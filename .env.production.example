# ---------------------------------------------------------------------------
# VIH VoiceRAG production configuration for the Docker Compose stack in deploy/.
#
#   cp .env.production.example .env.production && chmod 600 .env.production
#
# Then edit every line marked  # CHANGE ME.  Never commit .env.production (it holds secrets).
# Used two ways: as --env-file for compose interpolation (DOMAIN, POSTGRES_*, ...) and as the app
# container's env_file. Runbook: docs/DEPLOY.md.
# ---------------------------------------------------------------------------

# --- Stack (read by deploy/docker-compose.yml) ------------------------------
# Public hostname. Its DNS A record must point at this VM before first start (Let's Encrypt).
DOMAIN="voice.example.com"                       # CHANGE ME
# Let's Encrypt account / expiry-notice address.
ACME_EMAIL="ops@example.com"                     # CHANGE ME
POSTGRES_USER="voicerag"
POSTGRES_DB="vih_voicerag"
# Long random value, URL-safe (it is embedded in DATABASE_URL). Generate: openssl rand -hex 32
POSTGRES_PASSWORD="CHANGE_ME_openssl_rand_hex_32"  # CHANGE ME
# whisper.cpp decoder threads: physical cores you can spare (4 on a 4-8 vCPU VM).
WHISPER_THREADS=4

# --- App --------------------------------------------------------------------
NODE_ENV=production
PORT=3100
# Built from the values above; "db" is the compose service name. Do not edit unless you move Postgres.
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}?schema=public"
# Caddy sits in front and sets X-Forwarded-For; login rate limiting keys on the real client IP.
TRUST_PROXY=true
# Mounted volume (app-storage). Private; never served statically.
VOICERAG_STORAGE_DIR="/app/storage"
VOICERAG_MAX_UPLOAD_MB=20
# Days to keep conversations/messages/turn metrics (daily `npm run retention:purge`, see DEPLOY.md).
VOICERAG_RETENTION_DAYS=30
# Ingestion worker inside the web process (single-node deployment).
VOICERAG_INPROCESS_WORKER=true
# NOTE: VOICERAG_SEED_PASSWORD is intentionally absent. Create real accounts with `npm run admin:create`.

# --- Speech-to-text: whisper.cpp sidecar (service "stt"; audio never leaves the VM) ---------
STT_PROVIDER=whispercpp
WHISPERCPP_URL="http://stt:8178"
# Path inside the stt container; the app only uses the file name as a label in metrics.
WHISPERCPP_MODEL_PATH="/models/ggml-base.en.bin"
STT_PARTIAL_INTERVAL_MS=0
# Domain vocabulary passed to whisper as a decoding prompt (names, jargon). Max 600 chars.
STT_VOCABULARY="VIH Metaverse, Spaces, PeopleHub, Flagship, parental leave, per diem, pull request, SEV1, SEV2, on-call, postmortem, OpenXR, Quest 3, Vision Pro, cafeteria."
SPECULATIVE_PRERENDER=true

# --- LLM: Gemini 2.5 Flash (hosted by Google) -------------------------------
# Questions and retrieved document passages are sent to Google. Get written approval from your
# organisation before loading REAL (non-demo) documents. Key: https://aistudio.google.com/apikey
LLM_PROVIDER=gemini
LLM_MODEL="gemini-2.5-flash"
GEMINI_API_KEY="CHANGE_ME_gemini_api_key"        # CHANGE ME
GEMINI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"
# Disable Flash "thinking" for faster first tokens.
LLM_REASONING_EFFORT=none
# Empty = no silent fallback to a tiny local model. In production the app refuses to start while
# GEMINI_API_KEY is empty or still a CHANGE_ME placeholder (as it does for any CHANGE_ME value).
LLM_FALLBACK_MODEL=""
LLM_MAX_TOKENS=160
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_MS=15000
# USD per million tokens, for the cost-per-turn dashboard. Check current Gemini pricing.
LLM_PRICE_INPUT_PER_MTOK=0.30
LLM_PRICE_OUTPUT_PER_MTOK=2.50

# --- Embeddings: Ollama sidecar (service "ollama", CPU) ----------------------
EMBED_PROVIDER=ollama
EMBED_MODEL="nomic-embed-text"
# Must match the vector column (768).
EMBED_DIM=768
OLLAMA_URL="http://ollama:11434"

# --- Text-to-speech: Piper sidecar (service "tts"; text never leaves the VM) -----------------
TTS_PROVIDER=piper
PIPER_URL="http://tts:8179"
# Path inside the tts container; the app only uses the file name as a label.
PIPER_MODEL_PATH="/models/en_US-lessac-medium.onnx"
TTS_RATE_WPM=180

# --- Retrieval ------------------------------------------------------------------
RAG_TOP_K=3
RAG_CANDIDATES=12
CHUNK_TARGET_WORDS=100
CHUNK_OVERLAP_WORDS=20
RAG_MIN_VECTOR_SIM=0.73
RAG_MIN_VECTOR_SIM_WITH_KEYWORD=0.66
RAG_MIN_VECTOR_SIM_BORDERLINE=0.60
RAG_QUERY_GLOSSARY="peoplehub=HR portal leave requests; flagship=feature flags"
RAG_DOMAIN_STOPWORDS="vih metaverse company employee employees staff policy"
# Non-VIH questions with no matching documents get clearly-labelled general guidance from the LLM
# (false = always abstain).
GENERAL_ANSWERS=true
RAG_CACHE_TTL_SECONDS=300
RAG_CACHE_MAX_ENTRIES=500

# --- Limits -------------------------------------------------------------------------
VOICE_MAX_UTTERANCE_SECONDS=30
VOICE_TURNS_PER_MINUTE=20
VOICE_MAX_SESSIONS_PER_USER=3
